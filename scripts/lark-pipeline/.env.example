# Lark / Feishu app credentials (from Developer Console)
# Also accepted: LARK_APP_ID, LARK_APP_SECRET, etc.
APP_ID=
APP_SECRET=
VERIFICATION_TOKEN=
ENCRYPT_KEY=

# Private host: SSH target for running build-image and smoke
PRIVATE_HOST=
SSH_USER=root
SSH_KEY_PATH=~/.ssh/id_rsa
# SSH_PASSWORD=   # optional, if not using key

# InfiniLM-SVC repo path on private host
REPO_PATH=/home/zenghua/repos/InfiniLM-SVC
DEPLOYMENT_CASE=infinilm-metax-deployment-opt
BUILD_PHASE=dep-runtime
IMAGE_TAG=infinilm-svc:infinilm-demo

# Optional: HTTP proxy for build (e.g. http://127.0.0.1:7890)
# HTTP_PROXY=

# Optional: Post pipeline result to GitHub PR when user includes #42 or pr/123
GITHUB_TOKEN=
GITHUB_PAT=
GITHUB_REPO=owner/repo

# Webhook server
HOST=0.0.0.0
PORT=8080
# DEBUG=1
