# Environment variables for InfiniLM-SVC infinilm-metax-deployment-opt (Master)
#
# Copy this file to .env and customize:
#   cp .env.example .env
#   # Edit .env with your values
#
# Usage:
#   source .env
#   ./start-master.sh <REGISTRY_IP>

# Docker image and container (use latest infinilm-demo-runtime image)
IMAGE_NAME=infinilm-svc:infinilm-demo-runtime
CONTAINER_NAME=infinilm-svc-master-opt

# Deployment case
DEPLOYMENT_CASE=infinilm-metax-deployment-opt

# Launch components
LAUNCH_COMPONENTS=all

# Ports
REGISTRY_PORT=18000
ROUTER_PORT=8000
EMBEDDING_PORT=20002

# Master preset: when 3vllm, use 1 vLLM on master (no paged); requires slave SLAVE_PRESET=3vllm
# MASTER_PRESET=3vllm

# Babysitter configs (set automatically from MASTER_PRESET; embeddings appended if EMBEDDING_MODEL_DIR is set)
BABYSITTER_CONFIGS=master-9g_8b_thinking.toml master-qwen3-32b-paged.toml

# Required model paths (MUST be set - uncomment and set your paths)
MODEL1_DIR=/path/to/9g_8b_thinking_llama
MODEL2_DIR=/path/to/Qwen3-32B
# Or use QWEN3_32B_DIR instead of MODEL2_DIR:
# QWEN3_32B_DIR=/path/to/Qwen3-32B

# Optional model paths (for embedding server)
# EMBEDDING_MODEL_DIR=/path/to/MiniCPM-Embedding-Light
# RERANK_MODEL_DIR=/path/to/MiniCPM-Reranker-Light
# BCE_RERANK_MODEL_DIR=/path/to/bce-reranker-base_v1

# Optional directories (use container defaults if not set)
# INFINILM_DIR=/path/to/InfiniLM
# INFINICORE_DIR=/path/to/InfiniCore
# CONFIG_DIR=/path/to/config

# Optional: size-based routing threshold (bytes) if router supports it
# CACHE_TYPE_ROUTING_THRESHOLD=10000

# Proxy settings (optional)
# NO_PROXY=localhost,127.0.0.1,0.0.0.0
