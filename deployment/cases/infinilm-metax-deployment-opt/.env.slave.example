# Environment variables for InfiniLM-SVC infinilm-metax-deployment-opt (Slave)
#
# Copy this file to .env.slave and customize:
#   cp .env.slave.example .env.slave
#   # Edit .env.slave with your values
#
# Usage:
#   source .env.slave
#   ./start-slave.sh <MASTER_IP> <SLAVE_IP>

# Docker image (same as master - use latest infinilm-demo-runtime)
IMAGE_NAME=infinilm-svc:infinilm-demo-runtime
CONTAINER_NAME=infinilm-svc-slave-opt

# Deployment case
DEPLOYMENT_CASE=infinilm-metax-deployment-opt

# Launch components (slave only runs babysitter)
LAUNCH_COMPONENTS=babysitter

# Ports (for connecting to master)
REGISTRY_PORT=18000
ROUTER_PORT=8000

# Required model path (MUST be set - uncomment and set your path)
QWEN3_32B_DIR=/path/to/Qwen3-32B
# Or use MODEL2_GGUF:
# MODEL2_GGUF=/path/to/Qwen3-32B

# Optional directories (use container defaults if not set)
# INFINILM_DIR=/path/to/InfiniLM
# INFINICORE_DIR=/path/to/InfiniCore
# CONFIG_DIR=/path/to/config
