# Environment variables for 9g_8b deployment
#
# Copy this file to .env and customize:
#   cp .env.example .env
#
# Usage:
#   source .env
#   ./start-master.sh [REGISTRY_IP]
#
# Platform: nvidia (default) or metax
#   PLATFORM=nvidia  - uses infinilm-svc:nvidia (build with docker/nvidia/build-image.sh)
#   PLATFORM=metax  - uses infinilm-svc:metax (pre-built)

# Platform selection
PLATFORM=nvidia

# Docker image and container (overridden by PLATFORM when unset)
IMAGE_NAME=infinilm-svc:nvidia
CONTAINER_NAME=infinilm-svc-master

# Ports
REGISTRY_PORT=18000
ROUTER_PORT=8000

# Required model path (9g_8b_thinking_llama)
MODEL1_DIR=/path/to/9g_8b_thinking_llama

# Proxy for build (speeds up pip/conda/git downloads)
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
